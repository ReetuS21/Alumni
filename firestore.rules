rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // The super admin is identified by its login email (Firebase Auth guarantees emails are unique).
    function isAdmin() { return signedIn() && request.auth.token.email == 'superadmin@gmail.com'; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function userRole() { return me().role; }
    function myName() { return me().name; }
    // Accounts created before the approval system have no status and count as approved.
    function isApproved() { return signedIn() && me().get('status', 'approved') == 'approved'; }
    function isRole(r) { return signedIn() && userRole() == r; }
    function active(r) { return isRole(r) && isApproved(); }
    function canRead() { return isApproved() || isAdmin(); }
    function post(id) { return get(/databases/$(database)/documents/posts/$(id)).data; }
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 80; }

    // ---------- users ----------
    // New accounts start "pending"; only the super admin can approve, reject or suspend them.
    match /users/{uid} {
      allow get: if isOwner(uid) || canRead();
      allow list: if canRead();
      allow create: if isOwner(uid)
                    && request.resource.data.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && validName(request.resource.data.name)
                    && ((request.resource.data.role in ['student', 'teacher', 'alumni']
                         && request.resource.data.status == 'pending')
                        || (isAdmin() && request.resource.data.role == 'admin'
                            && request.resource.data.status == 'approved'));
      allow update: if (isOwner(uid) && onlyChanged(['name']) && validName(request.resource.data.name))
                    || (isAdmin() && uid != request.auth.uid
                        && onlyChanged(['status', 'reviewedAt', 'reviewedBy', 'reviewNote'])
                        && request.resource.data.status in ['pending', 'approved', 'rejected', 'suspended']);
      allow delete: if false;
    }

    // ---------- role profiles (owners may fill them in while pending) ----------
    match /studentProfiles/{uid} {
      allow read: if isOwner(uid) || canRead();
      allow write: if isOwner(uid) && isRole('student');
    }
    match /teacherProfiles/{uid} {
      allow read: if isOwner(uid) || canRead();
      allow write: if isOwner(uid) && isRole('teacher');
    }
    match /alumniProfiles/{uid} {
      allow read: if isOwner(uid) || canRead();
      allow write: if isOwner(uid) && isRole('alumni');
    }

    // ---------- posts: teachers & admin → notice / poll, alumni → hiring / test ----------
    match /posts/{postId} {
      allow read: if canRead();
      allow create: if signedIn()
                    && request.resource.data.postId == postId
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorName == myName()
                    && request.resource.data.authorRole == userRole()
                    && (((active('teacher') || isAdmin()) && request.resource.data.type in ['notice', 'poll'])
                        || (active('alumni') && request.resource.data.type in ['hiring', 'test']))
                    && (request.resource.data.type != 'poll'
                        || (request.resource.data.options is list
                            && request.resource.data.options.size() >= 2
                            && request.resource.data.options.size() <= 6));
      allow update: if signedIn() && resource.data.authorUid == request.auth.uid
                    && onlyChanged(['title', 'body', 'meta']);
      allow delete: if (signedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
    }

    // ---------- applications (id = postId_studentUid) ----------
    match /applications/{applicationId} {
      allow read: if signedIn()
                  && (resource.data.studentUid == request.auth.uid
                      || resource.data.postAuthorUid == request.auth.uid
                      || isAdmin());
      allow create: if active('student')
                    && applicationId == request.resource.data.postId + '_' + request.auth.uid
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.studentName == myName()
                    && request.resource.data.status == 'applied'
                    && post(request.resource.data.postId).type in ['hiring', 'test']
                    && request.resource.data.postAuthorUid == post(request.resource.data.postId).authorUid;
      allow update: if isApproved()
                    && resource.data.postAuthorUid == request.auth.uid
                    && onlyChanged(['status', 'updatedAt'])
                    && request.resource.data.status in ['applied', 'shortlisted', 'rejected'];
      allow delete: if (signedIn() && resource.data.studentUid == request.auth.uid && resource.data.status == 'applied')
                    || isAdmin();
    }

    // ---------- poll votes (id = postId_uid) ----------
    match /pollVotes/{voteId} {
      allow read: if canRead();
      allow create: if isApproved()
                    && request.resource.data.uid == request.auth.uid
                    && voteId == request.resource.data.postId + '_' + request.auth.uid
                    && post(request.resource.data.postId).type == 'poll'
                    && request.resource.data.selectedOption in post(request.resource.data.postId).options;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- global discussion ----------
    match /chatMessages/{messageId} {
      allow read: if canRead();
      allow create: if canRead()
                    && request.resource.data.senderUid == request.auth.uid
                    && request.resource.data.senderName == myName()
                    && request.resource.data.senderRole == userRole()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && (request.resource.data.replyTo == null
                        || (request.resource.data.replyTo is string
                            && exists(/databases/$(database)/documents/chatMessages/$(request.resource.data.replyTo))));
      allow update: if false;
      allow delete: if (signedIn() && resource.data.senderUid == request.auth.uid) || isAdmin();
    }

    // ---------- shortlists / referrals (id = alumniUid_studentUid) ----------
    match /shortlists/{shortlistId} {
      allow get: if signedIn()
                 && (shortlistId.split('_')[0] == request.auth.uid
                     || resource.data.studentUid == request.auth.uid
                     || isAdmin());
      allow list: if signedIn()
                  && (resource.data.alumniUid == request.auth.uid
                      || resource.data.studentUid == request.auth.uid
                      || isAdmin());
      allow create: if active('alumni')
                    && request.resource.data.alumniUid == request.auth.uid
                    && request.resource.data.alumniName == myName()
                    && request.resource.data.status == 'shortlisted'
                    && shortlistId == request.auth.uid + '_' + request.resource.data.studentUid;
      allow update: if isApproved() && resource.data.alumniUid == request.auth.uid
                    && onlyChanged(['status', 'updatedAt'])
                    && request.resource.data.status in ['shortlisted', 'referred'];
      allow delete: if (signedIn() && resource.data.alumniUid == request.auth.uid) || isAdmin();
    }

    // ---------- private alumni notes (id = alumniUid_studentUid) ----------
    match /shortlistNotes/{noteId} {
      allow read, write: if active('alumni') && noteId.split('_')[0] == request.auth.uid;
    }
  }
}

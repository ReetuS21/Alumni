# Copy this file to .env and fill in the values.
# On Vercel, add the same variables under Project Settings -> Environment Variables.

# ---- Firebase (required) — Console -> Project settings -> General -> Your apps -> Web app config
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id
# Optional: Google Analytics for Firebase
REACT_APP_FIREBASE_MEASUREMENT_ID=

# ---- Cloudinary (optional, free) — profile photos and certificate files
# Dashboard -> Cloud name; Settings -> Upload -> Add upload preset -> Signing mode: Unsigned
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=

# ---- EmailJS (optional, free: 200 emails/month) — email alerts
# 1) New registration -> email to REACT_APP_ADMIN_ALERT_EMAIL   2) Account approved -> email to the person
# Template variables: {{to_email}} {{to_name}} {{subject}} {{message}} {{link}}  (set the template's "To Email" to {{to_email}})
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
REACT_APP_ADMIN_ALERT_EMAIL=

# ---- App Check (optional, free) — reCAPTCHA v3 site key registered in Firebase Console -> App Check
REACT_APP_RECAPTCHA_SITE_KEY=

# ---- Shown on the Privacy Policy / Terms pages as the grievance contact
REACT_APP_CONTACT_EMAIL=
